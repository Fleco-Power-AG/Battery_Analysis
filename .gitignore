# ============================================================================
#  .gitignore  -  Hauptordner "17 Batterieanalyse"
#
#  Alles kommt aufs Repo AUSSER den Inhalten von "01 Durchgefuehrte Analysen"
#  (Kundenprojekte). Der Ordner selbst bleibt ueber .gitkeep erhalten.
# ============================================================================

# Kundenprojekte (Platzhalter "01 *" vermeidet den Umlaut im Ordnernamen)
/01 */*
!/01 */.gitkeep

# Technischer Ballast
__pycache__/
*.pyc
.vscode/
~$*
venv/
.venv/
*.log

# Probelaeufe im Code-Ordner
/05 Code/*.xlsx
/05 Code/*.pdf
/05 Code/*_QA.txt
